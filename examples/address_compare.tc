// AddressCompare - exercises 32-byte address equality and address-keyed maps.

contract AddressCompare {
    state {
        owner: address,
        allowed: map<address,u64>,
    }

    init() {
        self.owner = sender();
        allowed[sender()] = 1;
    }

    pub fn is_owner(candidate: address) -> u64 {
        if (self.owner == candidate) {
            return 1;
        }
        return 0;
    }

    pub fn is_allowed(candidate: address) -> u64 {
        if (allowed[candidate] == 1) {
            return 1;
        }
        return 0;
    }
}
